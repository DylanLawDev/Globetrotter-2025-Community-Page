# Rendered to /etc/nginx/conf.d/default.conf at container start; only ${PORT} is
# substituted (see NGINX_ENVSUBST_FILTER in the Dockerfile).
server {
    # IPv4-only on purpose: a `listen [::]:` line is a fatal error on hosts without
    # IPv6, and 0.0.0.0 is what Cloud Run's front end connects to.
    listen      ${PORT};
    server_name _;

    root  /usr/share/nginx/html;
    index index.html;

    access_log /dev/stdout main;
    error_log  /dev/stderr warn;

    # data.js is ~1.3 MB of JSON-ish text and world.js another 76 KB.
    gzip              on;
    gzip_min_length   1024;
    gzip_proxied      any;
    gzip_vary         on;
    gzip_types        text/css text/plain application/javascript application/json image/svg+xml;

    # Pages link each other with explicit .html, so no extensionless rewriting.
    location / {
        try_files $uri $uri/ =404;
    }

    # Photos are content-addressed by Discord id — safe to cache hard.
    location ~* \.(webp|png|jpe?g|gif|avif|woff2?)$ {
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
    }

    location = /healthz {
        access_log   off;
        default_type text/plain;
        return       200 "ok\n";
    }
}
